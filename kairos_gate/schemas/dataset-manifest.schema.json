{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/Kairos-Gate-for-X-Cell/schemas/dataset-manifest.schema.json",
  "title": "Kairos Dataset Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_id",
    "dataset_version",
    "adapter",
    "sources",
    "reuse_status",
    "minimum_independent_units"
  ],
  "properties": {
    "schema": {"const": "kairos.dataset-manifest.v0.1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"enum": ["live-seq-gse141064", "tabular-v0.1"]},
        "config": {"type": "object"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "url", "version", "sha256"],
        "properties": {
          "role": {"enum": ["metadata", "matrix"]},
          "url": {"type": "string", "format": "uri"},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "reuse_status": {"enum": ["clear", "unclear"]},
    "minimum_independent_units": {"type": "integer", "minimum": 2}
  }
}
