{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/Kairos-Gate-for-X-Cell/schemas/kairos-transition.schema.json",
  "title": "Kairos Transition Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "transition_id", "subject", "observed_at", "current_state",
    "phase_context", "perturbation", "target_state", "forecast",
    "gate_assessment", "decision", "justification", "provenance", "limitations"
  ],
  "properties": {
    "schema": {"const": "kairos.transition.v0.1"},
    "transition_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_context", "source_dataset", "sample_id"],
      "properties": {
        "cell_context": {"type": "string", "minLength": 1},
        "source_dataset": {"type": "string", "minLength": 1},
        "sample_id": {"type": "string", "minLength": 1}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedding_ref", "cell_identity", "quality"],
      "properties": {
        "embedding_ref": {"type": "string", "minLength": 1},
        "cell_identity": {"type": "string", "minLength": 1},
        "quality": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "phase_context": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["observed", "inferred", "unobserved"]},
          "label": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "method": {"type": "string"}
        }
      }
    },
    "perturbation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "duration_hours"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "dose": {"type": "string"},
        "duration_hours": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "target_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "marker_set_ref"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "marker_set_ref": {"type": "string", "minLength": 1}
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizon_hours", "response_ref", "target_reachability"],
      "properties": {
        "horizon_hours": {"type": "number", "exclusiveMinimum": 0},
        "response_ref": {"type": "string", "minLength": 1},
        "target_reachability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "gate_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectiveness", "identity_preservation", "toxicity_risk",
        "reversibility", "evidence_quality", "timing_confidence"
      ],
      "properties": {
        "effectiveness": {"type": "number", "minimum": 0, "maximum": 1},
        "identity_preservation": {"type": "number", "minimum": 0, "maximum": 1},
        "toxicity_risk": {"type": "number", "minimum": 0, "maximum": 1},
        "reversibility": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "timing_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "decision": {"enum": ["CANDIDATE_WINDOW", "WAIT", "EXCLUDE", "INSUFFICIENT_EVIDENCE"]},
    "justification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "model_version", "code_commit", "data_digest"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "code_commit": {"type": "string", "minLength": 1},
        "data_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
