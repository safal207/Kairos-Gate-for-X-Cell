{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/Kairos-Gate-for-X-Cell/schemas/partner-lab-evidence-handoff.schema.json",
  "title": "Partner Laboratory Evidence Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "status",
    "evidence_question",
    "current_evidence",
    "hypotheses_to_distinguish",
    "experimental_unit_contract",
    "temporal_identity_contract",
    "model_comparison_plan",
    "data_return_contract",
    "decision_matrix",
    "stop_hold_rules",
    "governance_gates",
    "claim_boundary",
    "operational_content",
    "next_action",
    "safety_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY_FOR_PARTNER_SCIENTIFIC_REVIEW", "HOLD", "BLOCK"]},
    "evidence_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "phenotype", "temporal_order", "biological_system", "decision_to_inform", "statement"],
      "properties": {
        "candidate": {"type": "string", "minLength": 1},
        "phenotype": {"type": "string", "minLength": 1},
        "temporal_order": {"type": "string", "minLength": 1},
        "biological_system": {"type": "string", "minLength": 1},
        "decision_to_inform": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "current_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "statement", "evidence_level", "role"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "evidence_level": {"enum": ["F0", "F1", "F2", "F3", "F4", "F5"]},
          "role": {"enum": ["supporting", "limiting", "blocking", "negative_result"]}
        }
      }
    },
    "hypotheses_to_distinguish": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "statement", "distinguishing_observation"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "distinguishing_observation": {"type": "string", "minLength": 1}
        }
      }
    },
    "experimental_unit_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_unit", "assignment_level", "lineage_required", "technical_units_not_replicates", "precision_justification_required"],
      "properties": {
        "required_unit": {"type": "string", "minLength": 1},
        "assignment_level": {"const": "biological_unit"},
        "lineage_required": {"const": true},
        "technical_units_not_replicates": {
          "type": "array",
          "minItems": 4,
          "items": {"enum": ["cell", "well", "plate", "library", "sequencing_run", "read", "image_frame"]},
          "uniqueItems": true
        },
        "precision_justification_required": {"const": true}
      }
    },
    "temporal_identity_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_state_before_transition", "later_phenotype_after_transition", "same_longitudinal_unit_linkage", "machine_auditable_lineage", "required_chain"],
      "properties": {
        "pre_state_before_transition": {"const": true},
        "later_phenotype_after_transition": {"const": true},
        "same_longitudinal_unit_linkage": {"const": true},
        "machine_auditable_lineage": {"const": true},
        "required_chain": {
          "type": "array",
          "minItems": 6,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "model_comparison_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_before_outcome_analysis", "model_families", "negative_controls_required", "changes_require_superseding_record"],
      "properties": {
        "frozen_before_outcome_analysis": {"const": true},
        "model_families": {
          "type": "array",
          "minItems": 4,
          "items": {"enum": ["candidate_only", "broader_baseline_state", "technical_confounder", "combined", "null_or_negative_control"]},
          "uniqueItems": true
        },
        "negative_controls_required": {"const": true},
        "changes_require_superseding_record": {"const": true}
      }
    },
    "data_return_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_readable", "deidentified_or_lawful", "lineage", "timing", "missingness", "transform_provenance", "model_diagnostics", "checksums", "deviations"],
      "properties": {
        "machine_readable": {"const": true},
        "deidentified_or_lawful": {"const": true},
        "lineage": {"const": true},
        "timing": {"const": true},
        "missingness": {"const": true},
        "transform_provenance": {"const": true},
        "model_diagnostics": {"const": true},
        "checksums": {"const": true},
        "deviations": {"const": true}
      }
    },
    "decision_matrix": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outcome_class", "observation", "interpretation_limit"],
        "properties": {
          "outcome_class": {"enum": ["shared_state", "direct_effect", "marker_only", "technical_confounding", "small_context_effect", "null_or_instability"]},
          "observation": {"type": "string", "minLength": 1},
          "interpretation_limit": {"type": "string", "minLength": 1}
        }
      }
    },
    "stop_hold_rules": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 1}
    },
    "governance_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution_determines_required_approvals", "qualified_principal_investigator", "domain_review", "quantitative_review", "biosafety_review_if_applicable", "ethics_review_if_applicable", "data_governance_review", "execution_authorized"],
      "properties": {
        "institution_determines_required_approvals": {"const": true},
        "qualified_principal_investigator": {"const": true},
        "domain_review": {"const": true},
        "quantitative_review": {"const": true},
        "biosafety_review_if_applicable": {"const": true},
        "ethics_review_if_applicable": {"const": true},
        "data_governance_review": {"const": true},
        "execution_authorized": {"const": false}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["association", "prediction", "causal", "tissue", "clinical_therapeutic"],
      "properties": {
        "association": {"enum": ["supported_with_limits", "not_established", "blocked"]},
        "prediction": {"enum": ["supported_with_limits", "not_established", "blocked"]},
        "causal": {"enum": ["not_established", "blocked"]},
        "tissue": {"const": "blocked"},
        "clinical_therapeutic": {"const": "blocked"}
      }
    },
    "operational_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_protocol_included", "recipes_or_concentrations_included", "dosing_or_treatment_included", "biological_modification_instructions_included", "human_experimentation_instructions_included"],
      "properties": {
        "physical_protocol_included": {"const": false},
        "recipes_or_concentrations_included": {"const": false},
        "dosing_or_treatment_included": {"const": false},
        "biological_modification_instructions_included": {"const": false},
        "human_experimentation_instructions_included": {"const": false}
      }
    },
    "next_action": {"type": "string", "minLength": 1},
    "safety_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "physical_biology_authorized", "ai_authorizes_execution"],
      "properties": {
        "mode": {"const": "computational_documentary_only"},
        "physical_biology_authorized": {"const": false},
        "ai_authorizes_execution": {"const": false},
        "notes": {"type": "string"}
      }
    }
  }
}
